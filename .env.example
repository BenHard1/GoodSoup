# Copier en .env.local pour le développement. Ne jamais versionner de vraies valeurs.

# URL et clé publique du projet Supabase (Project Settings > API). Visibles du navigateur, protégées par la RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publique de l'application (liens dans les e-mails et les invitations).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé secrète Supabase (secret / service_role). SERVEUR UNIQUEMENT : sert à la suppression de compte.
SUPABASE_SECRET_KEY=

# Fournisseur d'IA. « none » tant que l'IA n'est pas activée (Phase 2+).
AI_PROVIDER=none
